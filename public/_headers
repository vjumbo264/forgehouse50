# ForgeHouse 50 — cache policy (Cloudflare Pages _headers, deployed verbatim)
#
# Strategy (cache_player_profile_fixes_v1 / task-f03 — revised):
#   * HTML entry points + service worker + manifest: NO caching — a visitor
#     always fetches the latest document, which references the current
#     versioned asset filenames.
#   * Versioned app assets (app.vN.css / app.vN.js): the basename carries a
#     deploy version, so any content change ships under a NEW URL — safe to
#     cache immutably forever at both browser and CDN layers.
#   * Icons / branding images: STABLE URLs whose CONTENT changes across
#     deploys (new app icon) — they must revalidate. Marking them immutable
#     was the bug that kept the OLD PWA icon on users' devices.
#   * Avatars: content never changes at a given URL — immutable is correct.

# HTML entry points — always revalidate
/*.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

# Service worker must never be served stale, or old caches never get purged
/sw.js
  Cache-Control: no-cache, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate

# Versioned app assets — immutable (new deploy => new vN filename)
/app.v5.css
  Cache-Control: public, max-age=31536000, immutable

/app.v5.js
  Cache-Control: public, max-age=31536000, immutable

/app.v6.css
  Cache-Control: public, max-age=31536000, immutable

/app.v6.js
  Cache-Control: public, max-age=31536000, immutable

/app.v7.css
  Cache-Control: public, max-age=31536000, immutable

/app.v7.js
  Cache-Control: public, max-age=31536000, immutable

# Icons / branding — revalidate every load (content changes at stable URLs;
# the service worker also fetches these network-first)
/icons/*
  Cache-Control: no-cache, must-revalidate

/branding/*
  Cache-Control: no-cache, must-revalidate

# Avatars — immutable per URL (a given avatar-N N.png never changes content)
/avatars/*
  Cache-Control: public, max-age=31536000, immutable

# Audio streams through the proxy — browser range fetches must be cacheable
# so scrubbing back/forward never re-downloads the whole chapter.
/api/read/audio_proxy*
  Cache-Control: public, max-age=3600
