# HTML entry points & service worker — always revalidate
/*.html
  Cache-Control: no-cache, must-revalidate
/
  Cache-Control: no-cache, must-revalidate
/app/
  Cache-Control: no-cache, must-revalidate
/sw.js
  Cache-Control: no-cache, must-revalidate
/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate

# Hashed assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Icons & Branding — revalidate on deploy
/icons/*
  Cache-Control: no-cache, must-revalidate
/branding/*
  Cache-Control: no-cache, must-revalidate

# Avatars
/avatars/*
  Cache-Control: public, max-age=31536000, immutable

# Scripture translation bundles
/bundles/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
